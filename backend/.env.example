# Database (SQLite file path relative to backend working directory)
# DATABASE_PATH=data/billbook.db

# Default super admin (created on startup if this email is not registered yet)
SUPER_ADMIN_EMAIL=admin@truerp.local
SUPER_ADMIN_PASSWORD=change-me-in-production
SUPER_ADMIN_NAME=Super Admin
# SUPER_ADMIN_PHONE=

# Frontend URL (used for password reset links)
FRONTEND_URL=http://localhost:3000

# SMTP (required to send password reset emails; without this, reset links are logged to the server console)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@example.com
# SMTP_FROM_NAME=TruERP

# Storage Configuration
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=uploads
LOCAL_STORAGE_BASE_URL=/uploads

# AWS S3 Configuration
# STORAGE_TYPE=s3
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# S3_BASE_URL=https://your-bucket-name.s3.us-east-1.amazonaws.com
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Cloudflare R2 Configuration (S3-compatible)
# STORAGE_TYPE=cloudflare_r2
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key-id
# R2_SECRET_ACCESS_KEY=your-secret-access-key
# R2_BUCKET=your-bucket-name
# R2_BASE_URL=https://your-bucket-name.your-account-id.r2.cloudflarestorage.com
