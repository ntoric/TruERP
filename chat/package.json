{
  "name": "truerp-chat",
  "version": "1.0.0",
  "description": "Standalone AI chat interface for the TruERP MCP server. Supports Gemini, OpenRouter, and Ollama with full MCP tool calling.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^1.27.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^4.21.2",
    "openai": "^4.104.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
