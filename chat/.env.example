# --- TruERP backend credentials (passed through to the MCP server) ---
# Either TRUERP_TOKEN, or TRUERP_EMAIL + TRUERP_PASSWORD.
TRUERP_API_URL=http://localhost:8088
TRUERP_EMAIL=you@example.com
TRUERP_PASSWORD=your-password
# TRUERP_TOKEN=
# TRUERP_TOTP_CODE=
# TRUERP_STORE_ID=

# --- LLM provider keys (can also be entered in the UI, or per-request) ---
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# --- Advanced ---
# PORT=8788
# MCP_SERVER_PATH=../mcp-server/dist/index.js
# MCP_SERVER_COMMAND=           # full override, e.g. "node"
# MCP_SERVER_ARGS=              # JSON array or space-separated
# MAX_TOOL_RESULT_CHARS=40000
# MAX_AGENT_ITERATIONS=16
